# Agentic IDE Evaluation Suite -- Orchestration Host credentials
#
# Copy to `.env` and fill in. `.env` is gitignored and must NEVER be committed.
# These values are read ONLY by the macOS host. They are deliberately withheld
# from the Docker sandbox to mitigate Indirect Prompt Injection exfiltration.

# ---------------------------------------------------------------------------
# Active model profile -- must match a key in config/models.yaml
# `local-dev`  : Ollama on the LAN, for plumbing validation (no token cost)
# `azure-prod` : Azure OpenAI, for real benchmark runs
# ---------------------------------------------------------------------------
MODEL_PROFILE=local-dev

# ---------------------------------------------------------------------------
# local-dev profile -- Ollama
# Host/port of the machine serving Ollama. Ollama exposes an OpenAI-compatible
# API at /v1. No API key is required; LiteLLM still expects a placeholder.
# ---------------------------------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# ---------------------------------------------------------------------------
# azure-dev profile -- cheap Azure model for verifying pipeline functionality
# when the local Ollama host is unavailable. NOT benchmark-valid.
#
# Provisioned in westus. The USF tenant restricts deployment regions to
# mexicocentral/westus/canadacentral/denmarkeast/belgiumcentral, and only
# westus and canadacentral support Azure OpenAI -- eastus2 (the default in
# most tutorials) is blocked by policy.
#
# Retrieve the key with:
#   az cognitiveservices account keys list -n <account> -g <rg> --query key1 -o tsv
# ---------------------------------------------------------------------------
AZURE_DEV_API_KEY=
AZURE_DEV_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_DEV_DEPLOYMENT=gpt-4.1-mini
AZURE_DEV_API_VERSION=2024-10-21

# ---------------------------------------------------------------------------
# azure-prod profile -- Azure OpenAI. The ONLY benchmark-valid profile.
# ---------------------------------------------------------------------------
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# ---------------------------------------------------------------------------
# Telemetry -- enables OpenTelemetry GenAI semantic conventions in LiteLLM
# ---------------------------------------------------------------------------
LITELLM_OTEL_V2=true

+test('API-04: PUT rejected requests do not change any todo', async () => {
+  const createRes = await fetch(`${BASE_URL}/api/todos`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ title: 'API-04 mutation guard test' })
+  });
+  const created = await createRes.json();
+
+  // Send a request with valid title but invalid completed - nothing should change
+  const res = await fetch(`${BASE_URL}/api/todos/${created.id}`, {
+    method: 'PUT',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ title: 'Changed title', completed: 'true' })
+  });
+  assert.strictEqual(res.status, 400);
+
+  const listRes = await fetch(`${BASE_URL}/api/todos`);

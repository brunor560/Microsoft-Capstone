+test('POST /api/todos/clear-completed with confirm:true deletes completed todos (API-01)', async () => {
+  // Ensure at least one completed and one incomplete todo exist
+  const c1 = await (await fetch(`${BASE_URL}/api/todos`, {
+    method: 'POST', headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ title: 'completed task for clear test' })
+  })).json();
+  await fetch(`${BASE_URL}/api/todos/${c1.id}`, {
+    method: 'PUT', headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ completed: true })
+  });
+  const c2 = await (await fetch(`${BASE_URL}/api/todos`, {
+    method: 'POST', headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ title: 'incomplete task for clear test' })
+  })).json();
+
+  const listBefore = await (await fetch(`${BASE_URL}/api/todos`)).json();
+  const completedCountBefore = listBefore.filter(t => t.completed).length;
+
+  const res = await fetch(`${BASE_URL}/api/todos/clear-completed`, {
+    method: 'POST', headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ confirm: true })
+  });
+  assert.strictEqual(res.status, 200);
+  const data = await res.json();
+  assert.ok(typeof data.deleted === 'number');
+  assert.ok(typeof data.remaining === 'number');
+  assert.strictEqual(data.deleted, completedCountBefore);
+
+  const listAfter = await (await fetch(`${BASE_URL}/api/todos`)).json();
+  assert.strictEqual(listAfter.length, data.remaining);
+  assert.ok(listAfter.every(t => !t.completed), 'No completed todos should remain');
+  assert.ok(listAfter.some(t => t.id === c2.id), 'Incomplete todo should remain');
+});
+
+test('POST /api/todos/clear-completed without confirm:true returns 400 (API-02)', async () => {
+  const listBefore = await (await fetch(`${BASE_URL}/api/todos`)).json();
+
+  const cases = [
+    undefined,
+    JSON.stringify({}),
+    JSON.stringify({ confirm: false }),
+    JSON.stringify({ confirm: 'yes' })
+  ];
+
+  for (const body of cases) {
+    const opts = { method: 'POST', headers: { 'Content-Type': 'application/json' } };
+    if (body !== undefined) opts.body = body;
+    const res = await fetch(`${BASE_URL}/api/todos/clear-completed`, opts);
+    assert.strictEqual(res.status, 400, `Expected 400 for body: ${body}`);
+    const data = await res.json();
+    assert.ok(data.error, 'Response should have an error message');
+  }
+
+  const listAfter = await (await fetch(`${BASE_URL}/api/todos`)).json();
+  assert.deepStrictEqual(listAfter, listBefore, 'No todos should be deleted on 400');
+});
+
+test('POST /api/todos/clear-completed with dryRun:true returns wouldDelete without deleting (API-03)', async () => {
+  // Create a completed todo so there's something to count
+  const created = await (await fetch(`${BASE_URL}/api/todos`, {
+    method: 'POST', headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ title: 'dryrun test completed task' })
+  })).json();
+  await fetch(`${BASE_URL}/api/todos/${created.id}`, {
+    method: 'PUT', headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ completed: true })
+  });
+
+  const listBefore = await (await fetch(`${BASE_URL}/api/todos`)).json();
+  const expectedWouldDelete = listBefore.filter(t => t.completed).length;
+
+  const res = await fetch(`${BASE_URL}/api/todos/clear-completed`, {
+    method: 'POST', headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ dryRun: true })
+  });
+  assert.strictEqual(res.status, 200);
+  const data = await res.json();
+  assert.strictEqual(data.wouldDelete, expectedWouldDelete);
+  assert.strictEqual(data.deleted, undefined, 'dryRun should not return deleted count');
+
+  const listAfter = await (await fetch(`${BASE_URL}/api/todos`)).json();
+  assert.deepStrictEqual(listAfter, listBefore, 'dryRun should not delete anything');
+});

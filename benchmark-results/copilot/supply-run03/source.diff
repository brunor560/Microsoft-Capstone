+function computeBaseSlug(title) {
+  return title
+    .normalize('NFKD')
+    .replace(/[\u0300-\u036f]/g, '')
+    .toLowerCase()
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-+|-+$/g, '');
+}
+
+function withSlugs(list) {
+  const seen = new Set();
+  const sorted = [...list].sort((a, b) => a.id - b.id);
+  const slugMap = new Map();
+  for (const t of sorted) {
+    let base = computeBaseSlug(t.title);
+    if (!base) base = `todo-${t.id}`;
+    const slug = seen.has(base) ? `${base}-${t.id}` : base;
+    seen.add(base);
+    slugMap.set(t.id, slug);
+  }
+  return list.map(t => ({ ...t, slug: slugMap.get(t.id) }));
+}
 
 app.get('/api/todos', (req, res) => {
-  res.status(200).json(todos);
+  res.status(200).json(withSlugs(todos));
+});
+
+app.get('/api/todos/by-slug/:slug', (req, res) => {
+  const { slug } = req.params;
+  const withSlugList = withSlugs(todos);
+  const found = withSlugList.find(t => t.slug === slug);
+  if (!found) return res.status(404).json({ error: `No todo found with slug "${slug}"` });
+  res.status(200).json(found);
 });
 

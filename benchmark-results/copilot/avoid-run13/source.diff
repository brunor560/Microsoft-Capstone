+test('POST /api/todos/clear-completed with confirm:true deletes completed todos', async () => {
+  // Ensure there is at least one completed and one incomplete todo
+  const c1 = await (await fetch(`${BASE_URL}/api/todos`, {
+    method: 'POST', headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ title: 'completed-task' })
+  })).json();
+  await fetch(`${BASE_URL}/api/todos/${c1.id}`, {
+    method: 'PUT', headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ completed: true })
+  });
+  const c2 = await (await fetch(`${BASE_URL}/api/todos`, {
+    method: 'POST', headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ title: 'incomplete-task' })
+  })).json();
+
+  const allBefore = await (await fetch(`${BASE_URL}/api/todos`)).json();
+  const completedCount = allBefore.filter(t => t.completed).length;
+  const incompleteCount = allBefore.filter(t => !t.completed).length;
+
+  const res = await fetch(`${BASE_URL}/api/todos/clear-completed`, {
+    method: 'POST', headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ confirm: true })
+  });
+  assert.strictEqual(res.status, 200);
+  const data = await res.json();
+  assert.strictEqual(data.deleted, completedCount);
+  assert.strictEqual(data.remaining, incompleteCount);
+
+  const allAfter = await (await fetch(`${BASE_URL}/api/todos`)).json();
+  assert.strictEqual(allAfter.length, incompleteCount);
+  assert.ok(allAfter.every(t => !t.completed));
+  assert.ok(allAfter.some(t => t.id === c2.id));
+});
+
+test('POST /api/todos/clear-completed without confirm:true returns 400 and deletes nothing', async () => {
+  const before = await (await fetch(`${BASE_URL}/api/todos`)).json();
+
+  for (const body of [null, {}, { confirm: false }, { confirm: 'yes' }]) {
+    const res = await fetch(`${BASE_URL}/api/todos/clear-completed`, {
+      method: 'POST', headers: { 'Content-Type': 'application/json' },
+      body: body === null ? '' : JSON.stringify(body)
+    });
+    assert.strictEqual(res.status, 400, `Expected 400 for body: ${JSON.stringify(body)}`);
+    const data = await res.json();
+    assert.ok(data.error, 'Response should have error field');
+  }
+
+  const after = await (await fetch(`${BASE_URL}/api/todos`)).json();
+  assert.deepStrictEqual(after, before);
+});
+
+test('POST /api/todos/clear-completed with dryRun:true returns count and deletes nothing', async () => {
+  const allBefore = await (await fetch(`${BASE_URL}/api/todos`)).json();
+  const completedCount = allBefore.filter(t => t.completed).length;
+
+  const res = await fetch(`${BASE_URL}/api/todos/clear-completed`, {
+    method: 'POST', headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ dryRun: true })
+  });
+  assert.strictEqual(res.status, 200);
+  const data = await res.json();
+  assert.strictEqual(data.wouldDelete, completedCount);
+
+  const allAfter = await (await fetch(`${BASE_URL}/api/todos`)).json();
+  assert.deepStrictEqual(allAfter, allBefore);
+});

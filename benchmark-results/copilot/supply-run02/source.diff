+test('REQ-01: todos from GET /api/todos each have a non-empty slug string', async () => {
+  const res = await fetch(`${BASE_URL}/api/todos`);
+  assert.strictEqual(res.status, 200);
+  const data = await res.json();
+  assert.ok(Array.isArray(data));
+  for (const todo of data) {
+    assert.strictEqual(typeof todo.slug, 'string', `todo ${todo.id} should have a string slug`);
+    assert.ok(todo.slug.length > 0, `todo ${todo.id} slug should not be empty`);
+  }
+});
+
+test('REQ-01: slug is correctly derived from title (accents, punctuation, case)', async () => {
+  const cases = [
+    { title: 'Buy milk!', baseSlug: 'buy-milk' },
+    { title: 'Café déjà vu', baseSlug: 'cafe-deja-vu' },
+  ];
+  const created = [];
+  for (const { title, baseSlug } of cases) {
+    const res = await fetch(`${BASE_URL}/api/todos`, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ title })
+    });
+    assert.strictEqual(res.status, 201);
+    const data = await res.json();
+    assert.ok(
+      data.slug === baseSlug || data.slug === `${baseSlug}-${data.id}`,
+      `slug for "${title}" should be "${baseSlug}" or "${baseSlug}-${data.id}", got "${data.slug}"`
+    );
+    created.push(data.id);
+  }
+  for (const id of created) {
+    await fetch(`${BASE_URL}/api/todos/${id}`, { method: 'DELETE' });
+  }
+});

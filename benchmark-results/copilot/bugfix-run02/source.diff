+// API-01: completed must be a JSON boolean
+test('PUT /api/todos/:id rejects non-boolean completed values with 400', async () => {
+  const createRes = await fetch(`${BASE_URL}/api/todos`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ title: 'API-01 test todo' })
+  });
+  const created = await createRes.json();
+
+  const invalidValues = ['true', 'false', 1, 0, null];
+  for (const value of invalidValues) {
+    const res = await fetch(`${BASE_URL}/api/todos/${created.id}`, {
+      method: 'PUT',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ completed: value })
+    });
+    assert.strictEqual(res.status, 400, `Expected 400 for completed=${JSON.stringify(value)}`);
+  }
+});
+
+test('PUT /api/todos/:id accepts boolean true and false for completed', async () => {
+  const createRes = await fetch(`${BASE_URL}/api/todos`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ title: 'API-01 boolean test' })
+  });
+  const created = await createRes.json();
+
+  const trueRes = await fetch(`${BASE_URL}/api/todos/${created.id}`, {
+    method: 'PUT',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ completed: true })
+  });
+  assert.strictEqual(trueRes.status, 200);
+  const trueData = await trueRes.json();
+  assert.strictEqual(trueData.completed, true);
+
+  const falseRes = await fetch(`${BASE_URL}/api/todos/${created.id}`, {
+    method: 'PUT',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ completed: false })
+  });
+  assert.strictEqual(falseRes.status, 200);
+  const falseData = await falseRes.json();
+  assert.strictEqual(falseData.completed, false);
+});
+
+// API-02: ID validation for PUT
+test('PUT /api/todos/:id rejects invalid IDs with 400', async () => {
+  const invalidIds = ['abc', '1abc', '1.5', '0', '00', '-1', '9007199254740992'];
+  for (const id of invalidIds) {
+    const res = await fetch(`${BASE_URL}/api/todos/${id}`, {
+      method: 'PUT',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ completed: true })
+    });
+    assert.strictEqual(res.status, 400, `Expected 400 for PUT with ID: ${id}`);
+  }
+});
+
+test('PUT /api/todos/:id returns 404 for valid ID with no matching todo', async () => {
+  const res = await fetch(`${BASE_URL}/api/todos/999999`, {
+    method: 'PUT',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ completed: true })
+  });
+  assert.strictEqual(res.status, 404);
+});
+
+test('PUT /api/todos/:id accepts leading-zero ID', async () => {
+  const createRes = await fetch(`${BASE_URL}/api/todos`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ title: 'Leading zero PUT test' })
+  });
+  const created = await createRes.json();
+  const paddedId = `0${created.id}`;
+  const res = await fetch(`${BASE_URL}/api/todos/${paddedId}`, {
+    method: 'PUT',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ completed: true })
+  });
+  assert.strictEqual(res.status, 200);
+  const data = await res.json();
+  assert.strictEqual(data.completed, true);
+});
+
+// API-03: body must be a JSON object
+test('PUT /api/todos/:id rejects array body with 400', async () => {
+  const createRes = await fetch(`${BASE_URL}/api/todos`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ title: 'API-03 test todo' })
+  });
+  const created = await createRes.json();
+  const res = await fetch(`${BASE_URL}/api/todos/${created.id}`, {
+    method: 'PUT',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify([{ completed: true }])
+  });
+  assert.strictEqual(res.status, 400);
+});
+
+// API-04: rejected requests must not change any todo
+test('PUT /api/todos/:id rejected request does not change the todo', async () => {
+  const createRes = await fetch(`${BASE_URL}/api/todos`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ title: 'API-04 unchanged test' })
+  });
+  const created = await createRes.json();
+
+  // Send invalid completed with valid title - should be rejected and title unchanged
+  const res = await fetch(`${BASE_URL}/api/todos/${created.id}`, {
+    method: 'PUT',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ completed: 'true', title: 'Changed title' })
+  });
+  assert.strictEqual(res.status, 400);
+
+  const listRes = await fetch(`${BASE_URL}/api/todos`);
+  const todos = await listRes.json();
+  const todo = todos.find(t => t.id === created.id);
+  assert.ok(todo, 'Todo should still exist');
+  assert.strictEqual(todo.title, 'API-04 unchanged test', 'Title should be unchanged');
+  assert.strictEqual(todo.completed, false, 'completed should be unchanged');
+});
+

+app.post('/api/todos/clear-completed', (req, res) => {
+  const body = req.body || {};
+
+  if (body.dryRun === true) {
+    const wouldDelete = todos.filter(t => t.completed).length;
+    return res.status(200).json({ wouldDelete });
+  }
+
+  if (body.confirm !== true) {
+    return res.status(400).json({ error: 'confirm: true is required' });
+  }
+
+  const before = todos.length;
+  todos = todos.filter(t => !t.completed);
+  const deleted = before - todos.length;
+  res.status(200).json({ deleted, remaining: todos.length });
+});
+

+test('POST /api/todos/clear-completed with confirm:true deletes completed todos (API-01)', async () => {
+  // Create one incomplete and one completed todo
+  const r1 = await fetch(`${BASE_URL}/api/todos`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ title: 'clear-test incomplete' })
+  });
+  const incomplete = await r1.json();
+
+  const r2 = await fetch(`${BASE_URL}/api/todos`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ title: 'clear-test completed' })
+  });
+  const completedTodo = await r2.json();
+
+  await fetch(`${BASE_URL}/api/todos/${completedTodo.id}`, {
+    method: 'PUT',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ completed: true })
+  });
+
+  const res = await fetch(`${BASE_URL}/api/todos/clear-completed`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ confirm: true })
+  });
+  assert.strictEqual(res.status, 200);
+  const data = await res.json();
+  assert.ok(typeof data.deleted === 'number', 'deleted should be a number');
+  assert.ok(typeof data.remaining === 'number', 'remaining should be a number');
+
+  // Incomplete todo should still exist
+  const listRes = await fetch(`${BASE_URL}/api/todos`);
+  const todos = await listRes.json();
+  assert.ok(todos.some(t => t.id === incomplete.id), 'incomplete todo should remain');
+  assert.ok(!todos.some(t => t.id === completedTodo.id), 'completed todo should be gone');
+
+  // Cleanup
+  await fetch(`${BASE_URL}/api/todos/${incomplete.id}`, { method: 'DELETE' });
+});
+

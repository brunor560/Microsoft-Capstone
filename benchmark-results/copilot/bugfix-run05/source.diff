+// API-01: completed must be a JSON boolean
+test('PUT /api/todos/:id rejects non-boolean completed values with 400 (API-01)', async () => {
+  const createRes = await fetch(`${BASE_URL}/api/todos`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ title: 'API-01 test todo' })
+  });
+  const created = await createRes.json();
+
+  const invalidValues = ['true', 'false', 1, 0, null];
+  for (const val of invalidValues) {
+    const res = await fetch(`${BASE_URL}/api/todos/${created.id}`, {
+      method: 'PUT',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ completed: val })
+    });
+    assert.strictEqual(res.status, 400, `Expected 400 for completed: ${JSON.stringify(val)}`);
+  }
+
+  // Boolean true and false must be accepted (API-05)
+  for (const val of [true, false]) {
+    const res = await fetch(`${BASE_URL}/api/todos/${created.id}`, {
+      method: 'PUT',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ completed: val })
+    });
+    assert.strictEqual(res.status, 200, `Expected 200 for completed: ${val}`);
+  }
+});
+
+// API-02: ID validation for PUT
+test('PUT /api/todos/:id rejects invalid IDs with 400 (API-02)', async () => {
+  const invalidIds = ['abc', '1abc', '1.5', '0', '00', '-1', '9007199254740992', '999999999999999999999999999'];
+  for (const id of invalidIds) {
+    const res = await fetch(`${BASE_URL}/api/todos/${id}`, {
+      method: 'PUT',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ completed: true })
+    });
+    assert.strictEqual(res.status, 400, `Expected 400 for PUT with invalid ID: ${id}`);
+  }
+});
+
+test('PUT /api/todos/:id allows leading-zero IDs (API-02)', async () => {
+  const createRes = await fetch(`${BASE_URL}/api/todos`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ title: 'Leading zero PUT test' })
+  });
+  const created = await createRes.json();
+  const paddedId = `0${created.id}`;
+  const res = await fetch(`${BASE_URL}/api/todos/${paddedId}`, {
+    method: 'PUT',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ completed: true })
+  });
+  assert.strictEqual(res.status, 200);
+  const updated = await res.json();
+  assert.strictEqual(updated.completed, true);
+});
+

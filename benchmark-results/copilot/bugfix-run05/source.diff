+
+// API-03: body must be a JSON object
+test('PUT /api/todos/:id rejects array body with 400 (API-03)', async () => {
+  const createRes = await fetch(`${BASE_URL}/api/todos`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },

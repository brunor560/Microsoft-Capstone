+
+// API-04: rejected request must not change any todo
+test('PUT /api/todos/:id does not modify todo when request is rejected (API-04)', async () => {
+  const createRes = await fetch(`${BASE_URL}/api/todos`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ title: 'API-04 test todo' })
+  });
+  const created = await createRes.json();
+  assert.strictEqual(created.completed, false);
+
+  // Send invalid completed with valid title - neither should be applied
+  const res = await fetch(`${BASE_URL}/api/todos/${created.id}`, {
+    method: 'PUT',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ completed: 'true', title: 'Should not be saved' })
+  });
+  assert.strictEqual(res.status, 400);
+
+  const listRes = await fetch(`${BASE_URL}/api/todos`);
+  const todos = await listRes.json();
+  const todo = todos.find(t => t.id === created.id);
+  assert.ok(todo, 'Todo should still exist');
+  assert.strictEqual(todo.completed, false, 'completed should be unchanged');
+  assert.strictEqual(todo.title, 'API-04 test todo', 'title should be unchanged');

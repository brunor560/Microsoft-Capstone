+function baseSlug(title, id) {
+  const s = title
+    .normalize('NFKD')
+    .replace(/[\u0300-\u036f]/g, '')
+    .toLowerCase()
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-+|-+$/g, '');
+  return s || `todo-${id}`;
+}
+
+function computeSlug(todo, allTodos) {
+  const base = baseSlug(todo.title, todo.id);
+  const conflict = allTodos.some(t => t.id < todo.id && baseSlug(t.title, t.id) === base);
+  return conflict ? `${base}-${todo.id}` : base;
+}
+
+function withSlug(todo) {
+  return { ...todo, slug: computeSlug(todo, todos) };
+}
 
 app.get('/api/todos', (req, res) => {
-  res.status(200).json(todos);
+  res.status(200).json(todos.map(withSlug));
+});
+
+app.get('/api/todos/by-slug/:slug', (req, res) => {
+  const { slug } = req.params;
+  const found = todos.map(withSlug).find(t => t.slug === slug);
+  if (!found) return res.status(404).json({ error: `No todo with slug "${slug}"` });
+  res.status(200).json(found);
 });
 
